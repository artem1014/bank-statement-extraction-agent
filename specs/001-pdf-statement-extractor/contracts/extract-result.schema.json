{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/artem1014/bank-statement-extraction-agent/specs/001-pdf-statement-extractor/contracts/extract-result.schema.json",
  "title": "ExtractResult",
  "description": "Canonical structured output of the bank-statement extraction pipeline. Generated from packages/contracts/src/schemas.ts via zod-to-json-schema; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["account", "summary", "transactions", "extraction"],
  "properties": {
    "account": { "$ref": "#/$defs/Account" },
    "summary": { "$ref": "#/$defs/Summary" },
    "transactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Transaction" }
    },
    "extraction": { "$ref": "#/$defs/ExtractionMetadata" }
  },
  "$defs": {
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank", "account_last4", "period"],
      "properties": {
        "bank": { "type": ["string", "null"] },
        "account_last4": {
          "anyOf": [
            { "type": "string", "pattern": "^\\d{4}$" },
            { "type": "null" }
          ]
        },
        "period": { "$ref": "#/$defs/Period" }
      }
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end":   { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beginning_balance",
        "ending_balance",
        "deposits_total",
        "deposits_count",
        "withdrawals_total",
        "withdrawals_count",
        "reconciliation"
      ],
      "properties": {
        "beginning_balance": { "type": "number" },
        "ending_balance":    { "type": "number" },
        "deposits_total":    { "type": "number", "minimum": 0 },
        "deposits_count":    { "type": "integer", "minimum": 0 },
        "withdrawals_total": { "type": "number", "minimum": 0 },
        "withdrawals_count": { "type": "integer", "minimum": 0 },
        "reconciliation":    { "$ref": "#/$defs/Reconciliation" }
      }
    },
    "Reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "delta", "expected_ending"],
      "description": "Computed deterministically by the server after extraction; the LLM MUST emit any placeholder value here (e.g. ok=true, delta=0, expected_ending=ending_balance) — the server overwrites it.",
      "properties": {
        "ok":              { "type": "boolean" },
        "delta":           { "type": "number" },
        "expected_ending": { "type": "number" }
      }
    },
    "Transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "description", "deposit", "withdrawal", "source_span"],
      "properties": {
        "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": { "type": "string", "minLength": 1 },
        "deposit":     { "type": ["number", "null"], "minimum": 0 },
        "withdrawal":  { "type": ["number", "null"], "minimum": 0 },
        "source_span": { "$ref": "#/$defs/SourceSpan" }
      }
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "char_start", "char_end"],
      "properties": {
        "page":       { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "char_start": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "char_end":   { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "ExtractionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_version", "duration_ms", "warnings"],
      "properties": {
        "model":          { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "duration_ms":    { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
